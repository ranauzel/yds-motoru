# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur. .env.local git'e girmez.

# Neon → proje → Connect → "Connection string" (pooled). Örnek biçim:
# postgresql://KULLANICI:SIFRE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Kendi bilgisayarında Docker ile: postgresql://yds:yds@localhost:5432/yds

# Oturum şifreleme anahtarı. Üretmek için: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Uygulamanın adresi
BETTER_AUTH_URL=http://localhost:3000
# Herkese kayıt açılsın mı? (varsayılan kapalı; hesap: pnpm user:create)
# ALLOW_SIGNUP=true

# İçerik klasörü (varsayılan: repo kökündeki content/). Genelde boş bırak.
# CONTENT_DIR=
